# Copia este archivo a `.env` y rellena tus valores. NUNCA subas `.env` a GitHub.

# --- Supabase (obligatorio): Project Settings → API ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=tu-anon-public-key

# --- Recomendado en producción ---
# Tu URL desplegada (para los enlaces de rutinas compartidas)
VITE_WEB_ORIGIN=

# --- Opcionales ---
# Enlace a tu APK (si no lo pones, el botón "Descargar APK" no aparece)
VITE_APK_URL=
# Sentry para errores (si no lo pones, no se envía nada)
VITE_SENTRY_DSN=
